# Dados públicos do cliente Supabase; copie os valores do painel:
# Settings → API → Project URL e Publishable key.
# Nunca use service_role, senha do banco, token pessoal ou link de convite aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_PELA_SUA_CHAVE_PUBLICA

# URL do Apps Script (ponte de upload para o Google Drive)
# Obtenha esta URL após fazer o deploy do script em script.google.com
# Deploy → New deployment → Web app → Execute as "me" → Who has access "Anyone"
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SUA_URL_DO_APPS_SCRIPT/exec
